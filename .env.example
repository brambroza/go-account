# copy เป็น .env แล้วแก้ค่า — ห้าม commit .env
VITE_BASE_PATH=
VITE_SERVER_URL=

# local (ค่าเริ่มต้น) = demo เก็บข้อมูลใน localStorage · api = ใช้ go-account-api (ต้อง login)
VITE_DATA_MODE=local
# base URL ของ API — ไม่ตั้ง = /api/v1 (same-origin; ตอน dev vite proxy ส่งต่อไป VITE_API_PROXY_TARGET)
VITE_API_BASE_URL=
# ปลายทางของ vite proxy ตอน `yarn dev` (เฉพาะ dev server)
VITE_API_PROXY_TARGET=http://localhost:5070
