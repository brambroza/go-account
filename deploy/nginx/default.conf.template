# GO Account web — nginx (template: entrypoint แทน ${GA_*} ด้วย env ตอน start)
#   GA_API_UPSTREAM        ปลายทางของ /api (เช่น http://api:8080, App Platform: ${api.PRIVATE_URL})
#   GA_PUBLIC_SCHEME       scheme ที่ผู้ใช้เห็น (https เมื่อ TLS จบที่ edge — ส่ง X-Forwarded-Proto คงที่ ไม่เชื่อ header จาก client)
#   GA_TRUSTED_PROXY_CIDR  edge/load balancer ที่เชื่อ header IP จริง (default 127.0.0.1/32 = nginx เป็น edge เอง)
#   GA_REAL_IP_HEADER      header IP จริงของ edge (X-Forwarded-For; DO App Platform ส่ง do-connecting-ip)
#   GA_MAX_BODY            ขนาด request สูงสุด

map "${GA_PUBLIC_SCHEME}" $ga_hsts {
    https   "max-age=31536000";
    default "";
}

log_format ga_json escape=json '{"time":"$time_iso8601","request_id":"$request_id","remote_addr":"$remote_addr",'
    '"method":"$request_method","uri":"$uri","status":$status,"bytes":$body_bytes_sent,'
    '"duration":$request_time,"upstream_duration":"$upstream_response_time","user_agent":"$http_user_agent"}';

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log /dev/stdout ga_json;
    client_max_body_size ${GA_MAX_BODY};

    set_real_ip_from ${GA_TRUSTED_PROXY_CIDR};
    real_ip_header ${GA_REAL_IP_HEADER};
    real_ip_recursive on;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # health ของ container (ไม่ log)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # health ของ API สำหรับ UptimeRobot/LB: /health/live (process) และ /health (รวม DB) — ไม่มีข้อมูลลับใน response
    location ~ ^/health(/live)?$ {
        access_log off;
        proxy_pass ${GA_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Request-Id $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    # API — same-origin: cookie ของ API ผูกกับ origin ของหน้าเว็บ
    location /api/ {
        proxy_pass ${GA_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto ${GA_PUBLIC_SCHEME};
        proxy_set_header X-Request-Id $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_redirect off;
        # security headers + HSTS ของ API มาจาก API เอง (ไม่ใส่ซ้ำ)
    }

    # assets ที่มี hash ในชื่อไฟล์ — cache ได้นาน
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA: เส้นทางที่ไม่ใช่ไฟล์ → index.html (ไม่ cache เพื่อให้ได้ bundle ใหม่ทันทีหลัง deploy)
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    # ไม่เปิดไฟล์ที่ขึ้นต้นด้วยจุด (.env, .git ที่อาจหลุดมาใน dist)
    location ~ /\. {
        return 404;
    }
}
